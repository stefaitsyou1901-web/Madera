      }
    },
    {
      "cell_type": "code",
      "source": [],
      "metadata": {
        "id": "w-AwEGkqrtCp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "Madera=input(\"Tipo de madera: \")\n",
        "Precio=float(input(\"Precio por metro cuadrado: $\"))\n",
        "Ancho_cm=float(input(\"Ancho de la madera (cm): \"))\n",
        "Ancho_m=Ancho_cm/100\n",
        "Bultos=int(input(\"Cantidad de bultos despachados: \"))\n",
        "\n",
        "total_m2=0\n",
        "total_tablas=0\n",
        "\n",
        "for i in range(1, Bultos + 1):\n",
        "  print(\"\\nRegistro del bulto\", i)\n",
        "  alto_m=float(input(\"Alto del bulto (metros, ej. 1.2 o 0.9): \"))\n",
        "  cantidad_tablas=int(input(\"Cantidad de tablas del bulto: \"))\n",
        "  area=Ancho_m*alto_m*cantidad_tablas\n",
        "  total_m2+=area\n",
        "  total_tablas+=cantidad_tablas\n",
        "\n",
        "  print(\"Metros cuadrados del bulto:\", round(area, 2), \"m2\")\n",
        "\n",
        "valor_total=total_m2*Precio\n",
        "print(\"\\n--- Resumen del despacho ---\")\n",
        "print(\"total metros cuadrados:\", round(total_m2, 2), \"m2\")\n",
        "print(\"total tablas:\", total_tablas)\n",
        "print(\"valor total: $\", round(valor_total, 2))\n",
        "\n",
        "\n"
      ],
